{
  "compilerOptions": {
    "target": "ES2022", "useDefineForClassFields": true, "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx", "types": ["vite/client"],
    "strict": true, "noUncheckedIndexedAccess": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "skipLibCheck": true, "isolatedModules": true, "noEmit": true, "resolveJsonModule": true,
    "baseUrl": ".", "paths": { "@/*": ["src/*"] }
  },
  "include": ["src", "vite.config.ts"]
}
