<mxfile host="app.diagrams.net"><diagram name="Floss architecture" id="floss-arch"><mxGraphModel dx="1530" dy="870" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1530" pageHeight="870" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Floss architecture" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fontColor=#10282D;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="400" height="30" as="geometry"/></mxCell><mxCell id="sub" value="The web app and WhatsApp share one REST API. Numbers match the request path in the README." style="text;html=1;fontSize=13;align=left;verticalAlign=middle;fontColor=#4F6468;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="800" height="20" as="geometry"/></mxCell><mxCell id="lane_30" value="Channels" style="rounded=1;arcSize=2;html=1;fillColor=#F7FAFA;strokeColor=#DCE6E7;verticalAlign=top;align=left;spacingLeft=16;spacingTop=8;fontStyle=1;fontSize=13;fontColor=#4F6468;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="250" height="710" as="geometry"/></mxCell><mxCell id="lane_310" value="Identity and security" style="rounded=1;arcSize=2;html=1;fillColor=#F7FAFA;strokeColor=#DCE6E7;verticalAlign=top;align=left;spacingLeft=16;spacingTop=8;fontStyle=1;fontSize=13;fontColor=#4F6468;" vertex="1" parent="1"><mxGeometry x="310" y="90" width="250" height="710" as="geometry"/></mxCell><mxCell id="lane_590" value="REST API" style="rounded=1;arcSize=2;html=1;fillColor=#F7FAFA;strokeColor=#DCE6E7;verticalAlign=top;align=left;spacingLeft=16;spacingTop=8;fontStyle=1;fontSize=13;fontColor=#4F6468;" vertex="1" parent="1"><mxGeometry x="590" y="90" width="290" height="710" as="geometry"/></mxCell><mxCell id="lane_910" value="AI" style="rounded=1;arcSize=2;html=1;fillColor=#F7FAFA;strokeColor=#DCE6E7;verticalAlign=top;align=left;spacingLeft=16;spacingTop=8;fontStyle=1;fontSize=13;fontColor=#4F6468;" vertex="1" parent="1"><mxGeometry x="910" y="90" width="260" height="710" as="geometry"/></mxCell><mxCell id="lane_1190" value="Data" style="rounded=1;arcSize=2;html=1;fillColor=#F7FAFA;strokeColor=#DCE6E7;verticalAlign=top;align=left;spacingLeft=16;spacingTop=8;fontStyle=1;fontSize=13;fontColor=#4F6468;" vertex="1" parent="1"><mxGeometry x="1190" y="90" width="310" height="710" as="geometry"/></mxCell><mxCell id="web" value="&lt;b style=&quot;font-size:15px&quot;&gt;Floss web app&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#4F6468&quot;&gt;Plan holder on the web&lt;br&gt;React 19, Vite, TypeScript&lt;br&gt;Hosted on CloudFront + S3&lt;br&gt;HTTPS only&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#E3F1F2;strokeColor=#0A3D42;strokeWidth=1.6;fontColor=#10282D;" vertex="1" parent="1"><mxGeometry x="50" y="140" width="210" height="150" as="geometry"/></mxCell><mxCell id="wa" value="&lt;b style=&quot;font-size:15px&quot;&gt;WhatsApp via Twilio&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#4F6468&quot;&gt;Plan holder on WhatsApp&lt;br&gt;Ask in any language&lt;br&gt;Encrypted end to end by&lt;br&gt;WhatsApp, phone to Twilio&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#E3F1F2;strokeColor=#0A3D42;strokeWidth=1.6;fontColor=#10282D;" vertex="1" parent="1"><mxGeometry x="50" y="330" width="210" height="150" as="geometry"/></mxCell><mxCell id="cog" value="&lt;b style=&quot;font-size:15px&quot;&gt;Amazon Cognito&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#4F6468&quot;&gt;User pool: phone + password&lt;br&gt;Accounts created by the team&lt;br&gt;Issues the ID token (JWT)&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFF1D6;strokeColor=#B7791F;strokeWidth=1.6;fontColor=#10282D;" vertex="1" parent="1"><mxGeometry x="330" y="140" width="210" height="100" as="geometry"/></mxCell><mxCell id="sec" value="&lt;b style=&quot;font-size:15px&quot;&gt;Security controls&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#4F6468&quot;&gt;JWT checked on every /v1&lt;br&gt;app route&lt;br&gt;Twilio signature checked on&lt;br&gt;the WhatsApp webhook&lt;br&gt;WhatsApp accepted only from&lt;br&gt;a number that has an account&lt;br&gt;Phone comes from the token,&lt;br&gt;never from the request&lt;br&gt;Each patient reads only the&lt;br&gt;rows for their own phone&lt;br&gt;IAM database auth, no&lt;br&gt;stored passwords&lt;br&gt;TLS 1.2+ to API, Cognito&lt;br&gt;and database&lt;br&gt;RDS encrypted at rest&lt;br&gt;Bedrock over a private&lt;br&gt;VPC endpoint&lt;br&gt;CloudFront: HSTS and CSP&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFBF1;strokeColor=#B7791F;strokeWidth=1.6;fontColor=#10282D;dashed=1;dashPattern=2 4;" vertex="1" parent="1"><mxGeometry x="330" y="430" width="210" height="360" as="geometry"/></mxCell><mxCell id="gw" value="&lt;b style=&quot;font-size:15px&quot;&gt;Amazon API Gateway&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#4F6468&quot;&gt;REST-style HTTP API, /v1&lt;br&gt;Cognito JWT authorizer on&lt;br&gt;every app route&lt;br&gt;Signed webhook route for&lt;br&gt;Twilio&lt;br&gt;Throttled to 10 requests/s&lt;br&gt;Contract: packages/contracts&lt;br&gt;&lt;br&gt;About a 29 s limit per call&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#0A3D42;strokeWidth=1.6;fontColor=#10282D;" vertex="1" parent="1"><mxGeometry x="610" y="140" width="250" height="300" as="geometry"/></mxCell><mxCell id="core" value="&lt;b style=&quot;font-size:15px&quot;&gt;API Lambda&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#4F6468&quot;&gt;Verified phone from the JWT&lt;br&gt;Chat ledger; last 6 messages&lt;br&gt;go in as context&lt;br&gt;Retrieves that phone&amp;#x27;s rows,&lt;br&gt;answers in the user&amp;#x27;s language&lt;br&gt;Drops any $ not in the rows&lt;br&gt;Emails the chat transcript&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#0A3D42;strokeWidth=1.6;fontColor=#10282D;" vertex="1" parent="1"><mxGeometry x="610" y="480" width="250" height="170" as="geometry"/></mxCell><mxCell id="cost" value="&lt;b style=&quot;font-size:15px&quot;&gt;Cost engine&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#4F6468&quot;&gt;Integer-cents math from the&lt;br&gt;plan rules. The model never&lt;br&gt;does arithmetic.&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#0A3D42;strokeWidth=1.6;fontColor=#10282D;" vertex="1" parent="1"><mxGeometry x="610" y="690" width="250" height="100" as="geometry"/></mxCell><mxCell id="bed" value="&lt;b style=&quot;font-size:15px&quot;&gt;Amazon Bedrock&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#4F6468&quot;&gt;Titan Text Embeddings v2&lt;br&gt;Claude Haiku 4.5&lt;br&gt;Private VPC endpoint&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#E4F3EA;strokeColor=#1F7A4D;strokeWidth=1.6;fontColor=#10282D;" vertex="1" parent="1"><mxGeometry x="940" y="480" width="210" height="110" as="geometry"/></mxCell><mxCell id="pg" value="&lt;b style=&quot;font-size:15px&quot;&gt;Postgres + pgvector&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#4F6468&quot;&gt;Amazon RDS, 1024-dim vectors&lt;br&gt;Users and chat_messages&lt;br&gt;Treatment rows, hospitals, costs&lt;br&gt;Plan PDF chunks&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#E8EEF9;strokeColor=#3A5BA0;strokeWidth=1.6;fontColor=#10282D;" vertex="1" parent="1"><mxGeometry x="1210" y="460" width="270" height="200" as="geometry"/></mxCell><mxCell id="plan" value="&lt;b style=&quot;font-size:15px&quot;&gt;Plan data&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12.5px;color:#4F6468&quot;&gt;Carrier PDFs in Amazon S3,&lt;br&gt;parsed into PlanSummary tables&lt;br&gt;with the PDF page for each rule.&lt;/span&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#E8EEF9;strokeColor=#3A5BA0;strokeWidth=1.6;fontColor=#10282D;" vertex="1" parent="1"><mxGeometry x="1210" y="690" width="270" height="100" as="geometry"/></mxCell><mxCell id="ideas" value="&lt;b style=&quot;font-size:15px;color:#F2B544&quot;&gt;Key ideas&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;color:#FFFFFF&quot;&gt;RAG&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#C9DEDF&quot;&gt;Answers come from retrieved rows&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;color:#FFFFFF&quot;&gt;Context&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#C9DEDF&quot;&gt;Chat history goes into every turn&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;color:#FFFFFF&quot;&gt;REST API&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#C9DEDF&quot;&gt;One /v1 API for web and WhatsApp&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;color:#FFFFFF&quot;&gt;Cognito authentication&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#C9DEDF&quot;&gt;JWT checked on every app request&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;color:#FFFFFF&quot;&gt;Multilingual&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#C9DEDF&quot;&gt;Questions and answers in any language&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;color:#FFFFFF&quot;&gt;End-to-end encryption&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#C9DEDF&quot;&gt;WhatsApp encrypts phone to Twilio&lt;/span&gt;" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#0A3D42;strokeColor=none;fontColor=#FFFFFF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1210" y="140" width="270" height="290" as="geometry"/></mxCell><mxCell id="e0" value="sign in" style="endArrow=block;endFill=1;strokeColor=#0A3D42;strokeWidth=2;html=1;edgeStyle=none;labelBackgroundColor=#F7FAFA;fontSize=11;fontStyle=1;fontColor=#0A3D42;exitX=1.0000;exitY=0.3000;entryX=0.0000;entryY=0.4500;" edge="1" parent="1" source="web" target="cog"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="JWT" style="endArrow=block;endFill=1;strokeColor=#0A3D42;strokeWidth=2;html=1;edgeStyle=none;labelBackgroundColor=#F7FAFA;fontSize=11;fontStyle=1;fontColor=#0A3D42;exitX=1.0000;exitY=0.4500;entryX=0.0000;entryY=0.1500;" edge="1" parent="1" source="cog" target="gw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="REST, HTTPS, JWT" style="endArrow=block;endFill=1;strokeColor=#0A3D42;strokeWidth=2;html=1;edgeStyle=none;labelBackgroundColor=#F7FAFA;fontSize=11;fontStyle=1;fontColor=#0A3D42;exitX=1.0000;exitY=0.8667;entryX=0.0000;entryY=0.4333;" edge="1" parent="1" source="web" target="gw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n2" value="1" style="rounded=1;arcSize=50;html=1;fillColor=#F2B544;strokeColor=#0A3D42;fontStyle=1;fontSize=13;fontColor=#10282D;" vertex="1" parent="1"><mxGeometry x="423.0" y="258.0" width="24" height="24" as="geometry"/></mxCell><mxCell id="e3" value="HTTPS webhook, signed" style="endArrow=block;endFill=1;strokeColor=#0A3D42;strokeWidth=2;html=1;edgeStyle=none;labelBackgroundColor=#F7FAFA;fontSize=11;fontStyle=1;fontColor=#0A3D42;exitX=1.0000;exitY=0.3333;entryX=0.0000;entryY=0.8000;startArrow=block;startFill=1;" edge="1" parent="1" source="wa" target="gw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n3" value="1" style="rounded=1;arcSize=50;html=1;fillColor=#F2B544;strokeColor=#0A3D42;fontStyle=1;fontSize=13;fontColor=#10282D;" vertex="1" parent="1"><mxGeometry x="423.0" y="368.0" width="24" height="24" as="geometry"/></mxCell><mxCell id="e4" value="" style="endArrow=block;endFill=1;strokeColor=#0A3D42;strokeWidth=2;html=1;edgeStyle=none;labelBackgroundColor=#F7FAFA;fontSize=11;fontStyle=1;fontColor=#0A3D42;exitX=0.5000;exitY=1.0000;entryX=0.5000;entryY=0.0000;" edge="1" parent="1" source="gw" target="core"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n4" value="2" style="rounded=1;arcSize=50;html=1;fillColor=#F2B544;strokeColor=#0A3D42;fontStyle=1;fontSize=13;fontColor=#10282D;" vertex="1" parent="1"><mxGeometry x="723.0" y="448.0" width="24" height="24" as="geometry"/></mxCell><mxCell id="e5" value="" style="endArrow=block;endFill=1;strokeColor=#0A3D42;strokeWidth=2;html=1;edgeStyle=none;labelBackgroundColor=#F7FAFA;fontSize=11;fontStyle=1;fontColor=#0A3D42;exitX=1.0000;exitY=0.2353;entryX=0.0000;entryY=0.3636;startArrow=block;startFill=1;" edge="1" parent="1" source="core" target="bed"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n5" value="4" style="rounded=1;arcSize=50;html=1;fillColor=#F2B544;strokeColor=#0A3D42;fontStyle=1;fontSize=13;fontColor=#10282D;" vertex="1" parent="1"><mxGeometry x="888.0" y="508.0" width="24" height="24" as="geometry"/></mxCell><mxCell id="e6" value="context, vector search" style="endArrow=block;endFill=1;strokeColor=#0A3D42;strokeWidth=2;html=1;edgeStyle=none;labelBackgroundColor=#F7FAFA;fontSize=11;fontStyle=1;fontColor=#0A3D42;exitX=1.0000;exitY=0.8529;entryX=0.0000;entryY=0.8250;startArrow=block;startFill=1;" edge="1" parent="1" source="core" target="pg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n6" value="3" style="rounded=1;arcSize=50;html=1;fillColor=#F2B544;strokeColor=#0A3D42;fontStyle=1;fontSize=13;fontColor=#10282D;" vertex="1" parent="1"><mxGeometry x="1023.0" y="613.0" width="24" height="24" as="geometry"/></mxCell><mxCell id="e7" value="" style="endArrow=block;endFill=1;strokeColor=#0A3D42;strokeWidth=2;html=1;edgeStyle=none;labelBackgroundColor=#F7FAFA;fontSize=11;fontStyle=1;fontColor=#0A3D42;exitX=0.5000;exitY=1.0000;entryX=0.5000;entryY=0.0000;" edge="1" parent="1" source="core" target="cost"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="reads plan rules" style="endArrow=block;endFill=1;strokeColor=#0A3D42;strokeWidth=2;html=1;edgeStyle=none;labelBackgroundColor=#F7FAFA;fontSize=11;fontStyle=1;fontColor=#0A3D42;exitX=1.0000;exitY=0.5000;entryX=0.0000;entryY=0.5000;" edge="1" parent="1" source="cost" target="plan"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="lg0" value="Channels" style="rounded=1;html=1;fillColor=#E3F1F2;strokeColor=#0A3D42;strokeWidth=1.5;align=left;spacingLeft=34;fontSize=12;fontColor=#4F6468;" vertex="1" parent="1"><mxGeometry x="30" y="823" width="170" height="22" as="geometry"/></mxCell><mxCell id="lg1" value="Identity and security" style="rounded=1;html=1;fillColor=#FFF1D6;strokeColor=#B7791F;strokeWidth=1.5;align=left;spacingLeft=34;fontSize=12;fontColor=#4F6468;" vertex="1" parent="1"><mxGeometry x="220" y="823" width="170" height="22" as="geometry"/></mxCell><mxCell id="lg2" value="Compute" style="rounded=1;html=1;fillColor=#FFFFFF;strokeColor=#0A3D42;strokeWidth=1.5;align=left;spacingLeft=34;fontSize=12;fontColor=#4F6468;" vertex="1" parent="1"><mxGeometry x="410" y="823" width="170" height="22" as="geometry"/></mxCell><mxCell id="lg3" value="AI" style="rounded=1;html=1;fillColor=#E4F3EA;strokeColor=#1F7A4D;strokeWidth=1.5;align=left;spacingLeft=34;fontSize=12;fontColor=#4F6468;" vertex="1" parent="1"><mxGeometry x="600" y="823" width="170" height="22" as="geometry"/></mxCell><mxCell id="lg4" value="Data" style="rounded=1;html=1;fillColor=#E8EEF9;strokeColor=#3A5BA0;strokeWidth=1.5;align=left;spacingLeft=34;fontSize=12;fontColor=#4F6468;" vertex="1" parent="1"><mxGeometry x="790" y="823" width="170" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>