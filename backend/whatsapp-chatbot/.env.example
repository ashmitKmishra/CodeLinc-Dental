# ---- Twilio (Console home -> Account Info) ----
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+15551234567

# Public base URL Twilio calls (ngrok or your host), without /sms.
# Optional, but set it if you get 403 "Bad Twilio signature" errors.
PUBLIC_URL=
# Set to false ONLY for local curl testing.
TWILIO_VALIDATE_SIGNATURE=true

# ---- AWS / Bedrock ----
AWS_REGION=us-east-1
# Credentials: pick ONE of these, or leave all blank and use `aws configure` / an IAM role.
# AWS_PROFILE=default
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_BEARER_TOKEN_BEDROCK=      # Bedrock API key from the Bedrock console

# Your fine-tuned model: the custom model DEPLOYMENT ARN (on-demand) or a PROVISIONED THROUGHPUT ARN.
# Run `python chat.py --models` to list them. Leave blank to run on the backup model only.
BEDROCK_MODEL_ID=
# Stock model used when the fine-tuned one fails or isn't set. Ideally the base model you fine-tuned.
BEDROCK_FALLBACK_MODEL_ID=us.amazon.nova-lite-v1:0
# Set to false if the system prompt makes your fine-tune worse (it was trained without one).
BEDROCK_USE_SYSTEM_PROMPT=true
MAX_TOKENS=300
# SYSTEM_PROMPT=You are a helpful assistant that answers over SMS...

# ---- Optional last resort: any OpenAI-compatible API, used only if Bedrock fails ----
# Leave the Bedrock model IDs blank to use only this one.
# OpenAI:      OPENAI_BASE_URL blank, OPENAI_MODEL=gpt-4o-mini
# Gemini:      OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  OPENAI_MODEL=gemini-2.5-flash
# Groq:        OPENAI_BASE_URL=https://api.groq.com/openai/v1  OPENAI_MODEL=llama-3.3-70b-versatile
# OpenRouter:  OPENAI_BASE_URL=https://openrouter.ai/api/v1  OPENAI_MODEL=<any model slug>
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
# Gemini 2.5: set to none so hidden thinking doesn't eat MAX_TOKENS. Leave blank for OpenAI gpt-4o-mini.
OPENAI_REASONING_EFFORT=

# ---- Behaviour ----
# Comma-separated E.164 numbers allowed to use the bot. Blank = anyone.
ALLOWED_NUMBERS=
RATE_LIMIT_PER_MINUTE=5
HISTORY_TURNS=6
DB_PATH=chat.db
PORT=8080
