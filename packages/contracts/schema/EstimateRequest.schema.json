        "type": "object",
        "properties": {
          "procedureCode": {
            "type": "string"
          },
          "quoteCents": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "allowedCents": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "procedureCode",
          "quoteCents"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "memberId",
    "tierId",
    "date",
    "items"
  ],
  "additionalProperties": false
}
