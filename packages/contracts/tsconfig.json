{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2023"], "types": ["node"],
    "strict": true, "noUncheckedIndexedAccess": true, "skipLibCheck": true, "noEmit": true, "resolveJsonModule": true, "isolatedModules": true
  },
  "include": ["src", "scripts"]
}
